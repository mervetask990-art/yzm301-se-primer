# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. Main model for tutor, Pusula and review (default: gemini-3.6-flash).
# GEMINI_FALLBACK_MODELS: Optional, comma separated. Tried when the main model is overloaded or out of quota
#   (default: gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest).
#   Set to "" to pin one model, e.g. while running the eval, so every answer comes from the same model.
# GEMINI_THINKING: Optional. minimal | low | default (default: default). Applied to the main model only.
# Time candidate models on your key: http://localhost:3000/api/_diag?models=gemini-3.6-flash,gemini-2.5-flash (development only).
# GEMINI_MODEL="gemini-3.6-flash"
# GEMINI_FALLBACK_MODELS="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
